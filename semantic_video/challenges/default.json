{%- set p_clients = (client | default([16,32,64])) -%}
{%- set p_index_time = index_time_period | default(300) | int -%}
{%- set p_index_settings = index_settings | default({}) -%}
{
  "name": "semantic-video-indexing-stress-test",
  "description": "Continuously indexes video documents for {{ p_index_time }}s using {{ p_clients }} parallel client(s). Reports throughput, latency, successes and failures.",
  "default": true,
  "schedule": [
    {
      "operation": {
        "operation-type": "delete-index"
      }
    },
    {
      "operation": {
        "operation-type": "create-index",
        "settings": {{ p_index_settings | tojson }}
      }
    },
    {
      "operation": {
        "operation-type": "cluster-health",
        "request-params": {
          "wait_for_status": "green"
        },
        "retry-until-success": true
      }
    }
    {%- for i in range(p_clients|length) %},
    {
      "name": "index-videos-{{i}}",
      "operation": "bulk-index-videos",
      "clients": {{ p_clients[i] }},
      "time-period": {{ p_index_time }}
    }
    {%- endfor %}
  ]
}
